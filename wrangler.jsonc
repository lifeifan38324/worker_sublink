{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-sublink",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  // 只保留非敏感、可公开的变量。
  // SUBSCRIBE_MAP / CONVERT_CONFIG / TEMPLATE_URL 必须用 secret 存储：
  // Cloudflare 不允许 secret 与同名 var 共存（会报 Binding name already in use）。
  // 这三个变量的类型在 src/env.d.ts 里声明。
  // 线上值用 `npx wrangler secret put 变量名` 写入。
  "vars": {
    "ALLOW_LOCAL_FETCH": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 首页要把环境变量注入成占位符提示，必须先经过 Worker 再回落到静态资源
    "run_worker_first": true
  }
}
