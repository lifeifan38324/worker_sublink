# ---------- 敏感信息（最重要，绝不可提交）----------
# 本地开发变量：含订阅链接 token、密钥，用 .dev.vars.example 作为模板
.dev.vars
.dev.vars.*
*.dev.vars
# 示例文件要提交，用来告诉别人需要配哪些变量
!.dev.vars.example

# 通用环境变量文件
.env
.env.*
!.env.example

# 证书与密钥
*.pem
*.key
*.p12
*.pfx
id_rsa*
secrets.json

# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建产物与本地缓存 ----------
# .wrangler 下有 D1 本地数据、编译缓存、临时文件
.wrangler/
dist/
.output/
.vercel/
.turbo/
*.tsbuildinfo

# ---------- 运行日志 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------- Agent 本地数据 ----------
# .workbuddy/memory 会记录开发过程，可能带上订阅名、链接等运行信息
.workbuddy/

# ---------- 本地临时文件 ----------
tmp/
*.tmp
